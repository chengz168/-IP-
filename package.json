{
  "name": "super-ip-studio",
  "version": "0.1.0",
  "private": true,
  "description": "依据参考产品拆解实现的本地内容创作桌面工作台",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "pack": "npm run build && electron-builder --win dir"
  },
  "dependencies": {
    "@ant-design/icons-vue": "7.0.1",
    "ant-design-vue": "4.2.6",
    "lucide-vue-next": "^0.468.0",
    "pinyin": "4.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "40.10.6",
    "electron-builder": "^26.0.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "local.superip.studio",
    "productName": "超级IP智能体",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json",
      "integrations/indextts-local/**/*",
      "integrations/musetalk-local/**/*",
      "integrations/local-link-extractor/**/*",
      "integrations/qwen-voice-design/**/*",
      "integrations/portrait-matting/**/*"
    ],
    "asarUnpack": [
      "server/local-asr.py",
      "server/local-indextts.py",
      "integrations/indextts-local/**/*",
      "integrations/musetalk-local/**/*",
      "integrations/local-link-extractor/**/*",
      "integrations/qwen-voice-design/**/*",
      "integrations/portrait-matting/**/*"
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "electronDist": "node_modules/electron/dist"
  }
}
